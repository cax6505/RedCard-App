{
  "expo": {
    "name": "RedCard",
    "slug": "redcard-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "redcard",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10110d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redcard.app"
    },
    "android": {
      "package": "com.redcard.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10110d"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0687db51-a2a0-422a-abc9-51fe80b7df1b"
      }
    }
  }
}
